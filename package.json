{
  "name": "dhara-photography-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Dhara Photography ERP Pro V2 — monorepo root",
  "workspaces": [
    "03_Database",
    "05_Backend/backend",
    "04_Frontend/frontend",
    "09_Testing"
  ],
  "scripts": {
    "db:generate": "npm run db:generate --workspace=@dhara/database",
    "db:migrate": "npm run db:migrate --workspace=@dhara/database",
    "db:seed": "npm run db:seed --workspace=@dhara/database",
    "db:validate": "npm run db:validate --workspace=@dhara/database",
    "db:migrate:local": "npm run db:migrate:deploy --workspace=@dhara/database",
    "backend:dev": "npm run start:dev --workspace=@dhara/backend",
    "backend:start:local": "npm run start:prod --workspace=@dhara/backend",
    "backend:build": "npm run build --workspace=@dhara/backend",
    "backend:test": "npm run test --workspace=@dhara/backend",
    "frontend:dev": "npm run dev --workspace=@dhara/frontend",
    "frontend:build": "npm run build --workspace=@dhara/frontend",
    "frontend:test": "npm run test --workspace=@dhara/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed",
    "setup:local": "npm install && npm run db:generate && npm run db:migrate:local && npm run backend:build && npm run frontend:build",
    "backup:local": "powershell -ExecutionPolicy Bypass -File ./03_Database/scripts/backup-db.ps1",
    "restore:local": "powershell -ExecutionPolicy Bypass -File ./03_Database/scripts/restore-db.ps1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
