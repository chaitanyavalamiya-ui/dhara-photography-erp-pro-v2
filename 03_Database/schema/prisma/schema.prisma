generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["master", "transaction", "audit", "system"]
}

// ─── master schema ───────────────────────────────────────────────────────────

model Company {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  code         String
  isActive     Boolean   @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById String?   @map("archived_by_id") @db.Uuid
  archivedReason String? @map("archived_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid

  branches    CompanyBranch[]
  roles       Role[]
  permissions Permission[]
  users       User[]
  masterData  MasterData[]
  serviceRates ServiceRate[]
  clients     Client[]
  bookings    Booking[]
  invoices    Invoice[]
  payments    Payment[]
  expenses    Expense[]
  galleries   Gallery[]
  albums      Album[]
  staff       Staff[]
  auditLogs   AuditLog[]
  reminders   Reminder[]
  bookingStaffPayments BookingStaffPayment[]
  bookingStaff         BookingStaff[]
  bookingActivities    BookingActivity[]
  deliveries           Delivery[]
  equipment            Equipment[]
  equipmentIssues      EquipmentIssue[]
  equipmentReturns     EquipmentReturn[]
  equipmentHistory     EquipmentHistory[]

  @@unique([code])
  @@map("companies")
  @@schema("master")
}

model CompanyBranch {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String
  code         String
  isActive     Boolean   @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById String?   @map("archived_by_id") @db.Uuid
  archivedReason String? @map("archived_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryClients Client[] @relation("primary_client_branch")
  clientBranches ClientBranch[]
  bookings       Booking[]
  invoices       Invoice[]
  payments       Payment[]
  expenses       Expense[]
  galleries      Gallery[]
  albums         Album[]
  staff          Staff[]
  deliveries     Delivery[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, isActive])
  @@map("company_branches")
  @@schema("master")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  code           String
  name           String
  description    String?
  hierarchyRank  Int       @map("hierarchy_rank")
  isSystem       Boolean   @default(false) @map("is_system")
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById   String?   @map("archived_by_id") @db.Uuid
  archivedReason String?   @map("archived_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  userRoles   UserRole[]
  defaultUsers User[]          @relation("default_role")

  @@unique([companyId, code])
  @@map("roles")
  @@schema("master")
}

model Permission {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  code           String
  module         String
  action         String
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById   String?   @map("archived_by_id") @db.Uuid
  archivedReason String?   @map("archived_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles   RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, module, action])
  @@map("permissions")
  @@schema("master")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  scope        String   @default("ALL")
  isGranted    Boolean  @default(true) @map("is_granted")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  updatedById  String?  @map("updated_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("master")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  defaultRoleId   String?   @map("default_role_id") @db.Uuid
  fullName        String    @map("full_name")
  email           String    @map("email")
  normalizedEmail String    @map("normalized_email")
  passwordHash    String    @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById    String?   @map("archived_by_id") @db.Uuid
  archivedReason  String?   @map("archived_reason")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedById     String?   @map("updated_by") @db.Uuid

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultRole  Role?          @relation("default_role", fields: [defaultRoleId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]

  @@unique([companyId, normalizedEmail])
  @@index([companyId, isActive])
  @@map("users")
  @@schema("master")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("master")
}

model MasterData {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  category       String
  code           String
  label          String
  sortOrder      Int       @default(0) @map("sort_order")
  metadata       Json?
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById   String?   @map("archived_by_id") @db.Uuid
  archivedReason String?   @map("archived_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientStatuses Client[]  @relation("client_status")
  bookingStatuses Booking[] @relation("booking_status")
  paymentModes        Payment[]  @relation("payment_mode")
  expenseCategories   Expense[]  @relation("expense_category")
  expensePaymentModes Expense[]  @relation("expense_payment_mode")

  @@unique([companyId, category, code])
  @@unique([companyId, id])
  @@index([companyId, category, isActive])
  @@map("master_data")
  @@schema("master")
}

model ServiceRate {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String
  name        String
  category    String   @default("service")
  defaultRate Decimal  @map("default_rate") @db.Decimal(14, 2)
  unit        String   @default("day")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]

  @@unique([companyId, code])
  @@index([companyId, category, isActive])
  @@map("service_rates")
  @@schema("master")
}

// ─── transaction schema ──────────────────────────────────────────────────────

model Client {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  primaryBranchId String    @map("primary_branch_id") @db.Uuid
  clientNumber    String    @map("client_number")
  fullName        String    @map("full_name")
  mobile          String
  normalizedMobile String   @map("normalized_mobile")
  email           String?
  normalizedEmail String?   @map("normalized_email")
  whatsapp           String?
  normalizedWhatsapp String?   @map("normalized_whatsapp")
  address            String?
  city               String?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  anniversaryDate    DateTime? @map("anniversary_date") @db.Date
  notes              String?   @db.Text
  statusId        String?   @map("status_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById    String?   @map("archived_by_id") @db.Uuid
  archivedReason  String?   @map("archived_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  updatedById     String?   @map("updated_by") @db.Uuid

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryBranch CompanyBranch @relation("primary_client_branch", fields: [companyId, primaryBranchId], references: [companyId, id], onDelete: Restrict)
  status        MasterData?   @relation("client_status", fields: [companyId, statusId], references: [companyId, id], onDelete: Restrict)
  branches      ClientBranch[]
  bookings      Booking[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  galleries     Gallery[]
  albums        Album[]
  reminders     Reminder[]
  deliveries    Delivery[]

  @@unique([companyId, clientNumber])
  @@unique([companyId, normalizedMobile])
  @@unique([companyId, id])
  @@index([companyId, fullName])
  @@index([companyId, primaryBranchId, isActive])
  @@index([companyId, city])
  @@index([companyId, normalizedWhatsapp])
  @@index([companyId, dateOfBirth])
  @@index([companyId, anniversaryDate])
  @@map("clients")
  @@schema("transaction")
}

model ClientBranch {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  client Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branch CompanyBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([clientId, branchId])
  @@index([branchId, clientId])
  @@map("client_branches")
  @@schema("transaction")
}

model Staff {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  staffCode        String    @map("staff_code")
  fullName         String    @map("full_name")
  mobile           String?
  normalizedMobile String?   @map("normalized_mobile")
  email            String?
  normalizedEmail  String?   @map("normalized_email")
  address          String?   @db.Text
  role             String
  joiningDate      DateTime? @map("joining_date") @db.Timestamptz(6)
  paymentType      String    @default("per_event") @map("payment_type")
  defaultRate      Decimal   @default(0) @map("default_rate") @db.Decimal(14, 2)
  notes            String?   @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById     String?   @map("archived_by_id") @db.Uuid
  archivedReason   String?   @map("archived_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?   @map("created_by") @db.Uuid
  updatedById      String?   @map("updated_by") @db.Uuid

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      CompanyBranch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  assignments        BookingStaff[]
  expenses           Expense[]
  equipmentIssues    EquipmentIssue[]
  equipmentHistory   EquipmentHistory[]

  @@unique([companyId, staffCode])
  @@unique([companyId, id])
  @@index([companyId, role])
  @@index([companyId, isActive])
  @@map("staff")
  @@schema("transaction")
}

model Booking {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  bookingNumber  String    @map("booking_number")
  eventType      String    @default("Other") @map("event_type")
  statusId       String    @map("status_id") @db.Uuid
  eventDate      DateTime? @map("event_date") @db.Timestamptz(6)
  eventEndDate   DateTime? @map("event_end_date") @db.Timestamptz(6)
  venue          String?
  city           String?
  notes          String?   @db.Text
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  discount       Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  advanceAmount  Decimal   @default(0) @map("advance_amount") @db.Decimal(14, 2)
  balanceAmount  Decimal   @default(0) @map("balance_amount") @db.Decimal(14, 2)
  eventProgressStage String @default("booking_confirmed") @map("event_progress_stage")
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById   String?   @map("archived_by_id") @db.Uuid
  archivedReason String?   @map("archived_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   CompanyBranch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  client   Client        @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  status   MasterData    @relation("booking_status", fields: [companyId, statusId], references: [companyId, id], onDelete: Restrict)
  items    BookingItem[]
  invoices Invoice[]
  payments Payment[]
  expenses Expense[]
  galleries Gallery[]
  albums    Album[]
  staffAssignments BookingStaff[]
  equipmentItems   BookingEquipment[]
  activities       BookingActivity[]
  staffPayments    BookingStaffPayment[]
  reminders        Reminder[]
  deliveries       Delivery[]
  equipmentIssues  EquipmentIssue[]
  equipmentHistory EquipmentHistory[]

  @@unique([companyId, bookingNumber])
  @@unique([companyId, id])
  @@index([branchId, eventDate])
  @@index([clientId, eventDate])
  @@index([companyId, eventType])
  @@index([companyId, statusId])
  @@map("bookings")
  @@schema("transaction")
}

model BookingStaff {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  bookingId      String    @map("booking_id") @db.Uuid
  staffId        String    @map("staff_id") @db.Uuid
  role           String
  assignmentDate DateTime? @map("assignment_date") @db.Timestamptz(6)
  agreedRate     Decimal?  @map("agreed_rate") @db.Decimal(14, 2)
  notes          String?   @db.Text
  expenseId      String?   @unique @map("expense_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById   String?   @map("archived_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [companyId, bookingId], references: [companyId, id], onDelete: Cascade)
  staff   Staff   @relation(fields: [companyId, staffId], references: [companyId, id], onDelete: Restrict)
  expense Expense? @relation("booking_staff_expense", fields: [companyId, expenseId], references: [companyId, id], onDelete: SetNull)
  payments BookingStaffPayment[]

  @@unique([bookingId, staffId, role])
  @@unique([companyId, expenseId])
  @@index([staffId, assignmentDate])
  @@index([bookingId])
  @@map("booking_staff")
  @@schema("transaction")
}

model BookingItem {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  serviceRateId String?  @map("service_rate_id") @db.Uuid
  serviceName   String   @map("service_name")
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unit          String   @default("day")
  rate          Decimal  @db.Decimal(14, 2)
  days          Decimal  @default(1) @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(14, 2)
  notes         String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceRate ServiceRate? @relation(fields: [serviceRateId], references: [id], onDelete: SetNull)

  @@index([bookingId, sortOrder])
  @@map("booking_items")
  @@schema("transaction")
}

model BookingStaffPayment {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  bookingId      String    @map("booking_id") @db.Uuid
  bookingStaffId String    @map("booking_staff_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  status         String    @default("pending")
  paymentDate    DateTime? @map("payment_date") @db.Timestamptz(6)
  paymentMode    String?   @map("payment_mode")
  notes          String?   @db.Text
  expenseId      String?   @unique @map("expense_id") @db.Uuid
  recordedById   String?   @map("recorded_by") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  booking      Booking       @relation(fields: [companyId, bookingId], references: [companyId, id], onDelete: Cascade)
  bookingStaff BookingStaff  @relation(fields: [bookingStaffId], references: [id], onDelete: Cascade)
  expense      Expense?      @relation("booking_staff_payment_expense", fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([bookingId, paymentDate])
  @@index([bookingStaffId, status])
  @@map("booking_staff_payments")
  @@schema("transaction")
}

model BookingEquipment {
  id                String    @id @default(uuid()) @db.Uuid
  bookingId         String    @map("booking_id") @db.Uuid
  equipmentName     String    @map("equipment_name")
  quantityIssued    Decimal   @default(0) @map("quantity_issued") @db.Decimal(10, 2)
  quantityReturned  Decimal   @default(0) @map("quantity_returned") @db.Decimal(10, 2)
  status            String    @default("not_issued")
  issuedByName      String?   @map("issued_by_name")
  issuedAt          DateTime? @map("issued_at") @db.Timestamptz(6)
  returnedAt        DateTime? @map("returned_at") @db.Timestamptz(6)
  conditionCheckout String?   @map("condition_checkout")
  conditionReturn   String?   @map("condition_return")
  missingQuantity   Decimal   @default(0) @map("missing_quantity") @db.Decimal(10, 2)
  damagedQuantity   Decimal   @default(0) @map("damaged_quantity") @db.Decimal(10, 2)
  checkoutNotes     String?   @map("checkout_notes") @db.Text
  returnNotes       String?   @map("return_notes") @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?   @map("created_by") @db.Uuid
  updatedById       String?   @map("updated_by") @db.Uuid

