# ─── Dhara Photography ERP — Local Windows configuration ─────────────────────
# Copy to .env in the repository root. Works fully offline — no internet required.
# Never commit your real .env file to version control.

# ─── PostgreSQL (local Docker or local install) ──────────────────────────────
POSTGRES_USER=dhara
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=dhara_erp
POSTGRES_PORT=5432

# Prisma connection string — local PostgreSQL only
DATABASE_URL=postgresql://dhara:change_me_in_local_env@localhost:5432/dhara_erp?schema=public

# ─── Backend API (localhost) ─────────────────────────────────────────────────
BACKEND_PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT — use strong random secrets even for local installs (openssl rand -base64 48)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Login security (local in-memory rate limits; no Redis/cloud required)
# AUTH_LOGIN_RATE_LIMIT=20
# AUTH_LOGIN_RATE_WINDOW_MS=900000
# AUTH_REFRESH_RATE_LIMIT=60
# AUTH_REFRESH_RATE_WINDOW_MS=900000
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_DURATION_MINUTES=15

# ─── Development seed (first-time setup only) ─────────────────────────────────
# Used by `npm run db:seed` in development. Blocked when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@dharaphotography.local
SEED_ADMIN_PASSWORD=change_me_dev_password

# ─── Local application paths ─────────────────────────────────────────────────
# ERP web UI URL (localhost only)
APP_URL=http://localhost:5173

# Gallery uploads — relative to backend working directory (05_Backend/backend/)
# For a future packaged install, this may point under %LOCALAPPDATA%\DharaPhotographyERP\
UPLOAD_DIR=uploads

# ─── Frontend (localhost API) ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ─── Local backups ───────────────────────────────────────────────────────────
# Default backup folder. Copy backups to a pendrive monthly. Never auto-deleted.
BACKUP_DIR=%LOCALAPPDATA%\DharaPhotographyERP\Backups

# Packaged Windows installs can set a data root for backups, uploads, config, logs:
# DHARA_DATA_ROOT=%LOCALAPPDATA%\DharaPhotographyERP

# ─── Robo AI (optional) ──────────────────────────────────────────────────────
# Leave unset for local ERP-only replies. Never put keys in frontend env vars.
# ROBO_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
