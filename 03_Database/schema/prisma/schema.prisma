}

model EquipmentReturn {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  returnedAt  DateTime @map("returned_at") @db.Timestamptz(6)
  status      String
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  company Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  issue   EquipmentIssue        @relation(fields: [companyId, issueId], references: [companyId, id], onDelete: Restrict)
  items   EquipmentReturnItem[]
  history EquipmentHistory[]

  @@index([issueId, returnedAt])
  @@index([companyId, returnedAt])
  @@unique([companyId, id])
  @@map("equipment_returns")
  @@schema("transaction")
}

model EquipmentReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  returnId         String  @map("return_id") @db.Uuid
  issueItemId      String  @map("issue_item_id") @db.Uuid
  quantityReturned Int     @map("quantity_returned")
  missingQuantity  Int     @default(0) @map("missing_quantity")
  damagedQuantity  Int     @default(0) @map("damaged_quantity")
  conditionIn      String  @map("condition_in")
  returnStatus     String  @map("return_status")
  notes            String? @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  return    EquipmentReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  issueItem EquipmentIssueItem @relation(fields: [issueItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([issueItemId])
  @@map("equipment_return_items")
  @@schema("transaction")
}

model EquipmentHistory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  equipmentId  String   @map("equipment_id") @db.Uuid
  issueId      String?  @map("issue_id") @db.Uuid
  returnId     String?  @map("return_id") @db.Uuid
  bookingId    String?  @map("booking_id") @db.Uuid
  staffId      String?  @map("staff_id") @db.Uuid
  action       String
  quantity     Int      @default(1)
  conditionOut String?  @map("condition_out")
  conditionIn  String?  @map("condition_in")
  notes        String?  @db.Text
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment Equipment       @relation(fields: [companyId, equipmentId], references: [companyId, id], onDelete: Restrict)
  issue     EquipmentIssue? @relation(fields: [companyId, issueId], references: [companyId, id], onDelete: SetNull)
  return    EquipmentReturn? @relation(fields: [companyId, returnId], references: [companyId, id], onDelete: SetNull)
  booking   Booking?        @relation(fields: [companyId, bookingId], references: [companyId, id], onDelete: SetNull)
  staff     Staff?          @relation(fields: [companyId, staffId], references: [companyId, id], onDelete: SetNull)

  @@index([equipmentId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([staffId, occurredAt])
  @@index([companyId, action])
  @@map("equipment_history")
  @@schema("transaction")
}
