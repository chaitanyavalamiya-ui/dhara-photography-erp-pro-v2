# ─── PostgreSQL (Docker) ───────────────────────────────────────────────────────
POSTGRES_USER=dhara
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=dhara_erp
POSTGRES_PORT=5432

# Prisma connection string (used by backend and database package)
DATABASE_URL=postgresql://dhara:change_me_in_local_env@localhost:5432/dhara_erp?schema=public

# ─── Backend API ───────────────────────────────────────────────────────────────
BACKEND_PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# JWT — generate strong random secrets for local development
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Development seed credentials ────────────────────────────────────────────
# These are used ONLY by `npm run db:seed` in development.
# Never use these values in production.
SEED_ADMIN_EMAIL=admin@dharaphotography.local
SEED_ADMIN_PASSWORD=change_me_dev_password

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
